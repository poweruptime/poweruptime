{
  "assignees": ["Dafnik"],
  "baseBranchPatterns": ["main"],
  "commitBody": "See associated pull request for more information.",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["infrastructure/versions.env"],
      "matchStrings": ["IMAGE=\"(?<depName>.+?):(?<currentValue>.+)\" # renovate"]
    }
  ],
  "extends": [
    "config:recommended",
    ":pinVersions",
    "npm:unpublishSafe",
    ":preserveSemverRanges",
    ":rebaseStalePrs",
    ":semanticCommitTypeAll(chore)"
  ],
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "automerge": true,
    "automergeType": "branch",
    "commitMessageAction": "lock file maintenance",
    "enabled": true,
    "semanticCommitType": "chore(deps)"
  },
  "packageRules": [
    {
      "groupName": "Jackson dependencies",
      "matchPackageNames": ["/^com.fasterxml.jackson/i"]
    },
    {
      "groupName": "spring boot",
      "matchDepNames": ["/^org.springframework.boot/i"]
    },
    {
      "groupName": "Kotlin dependencies",
      "matchPackageNames": ["/^org.jetbrains.kotlin/i"]
    },
    {
      "groupName": "JWT dependencies",
      "matchPackageNames": ["/^io.jsonwebtoken/i"]
    },
    {
      "groupName": "NanoID",
      "matchPackageNames": ["/^io.viascom.nanoid/i"]
    },
    {
      "groupName": "DNS Java",
      "matchPackageNames": ["/^dnsjava/i"]
    },
    {
      "groupName": "Apache dependencies",
      "matchPackageNames": ["/^org.apache/i"]
    },
    {
      "groupName": "Liquibase dependencies",
      "matchPackageNames": ["/^org.liquibase/"]
    },
    {
      "groupName": "Postgres",
      "matchPackageNames": ["/^org.postgresql/i", "/^io.hypersistence/i"]
    },
    {
      "groupName": "Springdoc dependencies",
      "matchPackageNames": ["/^org.springdoc/i"]
    },
    {
      "groupName": "Bucket4j dependencies",
      "matchPackageNames": ["/^com.bucket4j/i"]
    },
    {
      "groupName": "Testcontainers",
      "matchPackageNames": ["/^org.testcontainers/i", "/^com.icegreen/i"]
    },
    {
      "groupName": "React",
      "matchPackageNames": [
        "/^react$/i",
        "/^react-dom$/i",
        "/^@types/react$/i",
        "/^@types/react-dom$/i"
      ]
    },
    {
      "groupName": "React Email",
      "matchPackageNames": ["/^react-email/i", "/^@react-email//i"]
    },
    {
      "groupName": "ngx-dropzone",
      "matchPackageNames": ["/^@ngx-dropzone/i"]
    },
    {
      "groupName": "ngrx",
      "matchPackageNames": ["/^@ngrx/i"]
    },
    {
      "groupName": "transloco",
      "matchPackageNames": ["/^@jsverse/i"]
    },
    {
      "groupName": "typescript types",
      "matchPackageNames": ["/^@types/i", "!@types/react", "!@types/react-dom"]
    },
    {
      "groupName": "typescript dependencies",
      "matchPackageNames": ["typescript", "tslib"]
    },
    {
      "extends": ["monorepo:angular"],
      "groupName": "angular monorepo"
    },
    {
      "extends": ["monorepo:angular-cli"],
      "groupName": "angular monorepo"
    },
    {
      "groupName": "Lint packages",
      "matchPackageNames": ["/lint/i"]
    }
  ],
  "prHourlyLimit": 5,
  "schedule": ["* * 1,15 * *"],
  "semanticCommitScope": "",
  "semanticCommitType": "build",
  "semanticCommits": "enabled",
  "timezone": "Europe/Vienna"
}
