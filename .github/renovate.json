{
  "baseBranches": ["main"],
  "semanticCommits": "enabled",
  "semanticCommitScope": "",
  "semanticCommitType": "build",
  "commitBody": "See associated pull request for more information.",
  "schedule": ["* * 1,15 * *"],
  "timezone": "Europe/Vienna",
  "labels": ["dependencies"],
  "assignees": ["Dafnik"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "commitMessageAction": "lock file maintenance",
    "semanticCommitType": "build"
  },
  "packageRules": [
    {
      "matchPackagePatterns": ["^com\\.fasterxml\\.jackson"],
      "groupName": "Jackson dependencies"
    },
    {
      "groupName": "spring boot",
      "matchDepNames": ["org.springframework.boot"]
    },
    {
      "groupName": "spring boot",
      "matchPackageNames": ["org.springframework.boot:**"]
    },
    {
      "matchPackagePatterns": ["^org\\.jetbrains\\.kotlin"],
      "groupName": "Kotlin dependencies"
    },
    {
      "matchPackagePatterns": ["^io\\.jsonwebtoken"],
      "groupName": "JWT dependencies"
    },
    {
      "matchPackagePatterns": ["^io\\.viascom.nanoid"],
      "groupName": "NanoID"
    },
    {
      "matchPackagePatterns": ["^dnsjava"],
      "groupName": "DNS Java"
    },
    {
      "matchPackagePatterns": ["^org\\.apache\\."],
      "groupName": "Apache dependencies"
    },
    {
      "matchPackagePatterns": ["^org\\.liquibase"],
      "groupName": "Liquibase dependencies"
    },
    {
      "matchPackagePatterns": ["^org\\.postgresql", "^io\\.hypersistence"],
      "groupName": "Postgres"
    },
    {
      "matchPackagePatterns": ["^org\\.springdoc"],
      "groupName": "Springdoc dependencies"
    },
    {
      "matchPackagePatterns": ["^com\\.bucket4j"],
      "groupName": "Bucket4j dependencies"
    },
    {
      "matchPackagePatterns": ["^org\\.testcontainers", "^com\\.icegreen"],
      "groupName": "Testcontainers"
    },
    {
      "matchPackagePatterns": [
        "@react-email/components",
        "react-email",
        "react",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "React Email"
    },
    {
      "matchPackageNames": ["typescript", "tslib"],
      "groupName": "typescript dependencies"
    },
    {
      "extends": ["monorepo:angular"],
      "groupName": "angular monorepo",
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    },
    {
      "extends": ["monorepo:angular-cli"],
      "groupName": "angular-cli monorepo",
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    }
  ],
  "extends": [
    "config:base",
    ":pinVersions",
    ":unpublishSafe",
    ":prNotPending",
    ":preserveSemverRanges",
    ":rebaseStalePrs"
  ]
}
