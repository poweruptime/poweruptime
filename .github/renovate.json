{
  "assignees": ["Dafnik"],
  "baseBranchPatterns": ["main"],
  "commitBody": "See associated pull request for more information.",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["infrastructure/versions.env"],
      "matchStrings": ["IMAGE=\"(?<depName>.+?):(?<currentValue>.+)\" # renovate"]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["backend/src/test/**/**.kt"],
      "matchStrings": ["\"(?<depName>[^\"\\s:]+):(?<currentValue>[^\"\\s]+)\"\\) // renovate"]
    }
  ],
  "extends": [
    "config:recommended",
    ":pinVersions",
    "security:minimumReleaseAgeNpm",
    ":preserveSemverRanges",
    ":rebaseStalePrs",
    ":semanticCommitTypeAll(chore)"
  ],
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "automerge": true,
    "automergeType": "branch",
    "commitMessageAction": "lock file maintenance",
    "enabled": true,
    "semanticCommitType": "chore(deps)"
  },
  "packageRules": [
    {
      "groupName": "typescript dependencies",
      "matchPackageNames": ["typescript", "tslib"]
    },
    {
      "extends": ["monorepo:angular"],
      "groupName": "angular monorepo"
    },
    {
      "extends": ["monorepo:angular-cli"],
      "groupName": "angular monorepo"
    },
    {
      "description": "Group minor and patch updates by package manager",
      "groupName": "{{manager}} minor & patch updates",
      "groupSlug": "{{manager}}-minor-patch",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group major updates by package manager",
      "groupName": "{{manager}} major updates",
      "groupSlug": "{{manager}}-major",
      "matchUpdateTypes": ["major"]
    },
    {
      "dependencyDashboardApproval": true,
      "description": "PostgreSQL major updates require a manual data migration, keep them separate and opt-in",
      "groupName": "postgres major update",
      "groupSlug": "postgres-major",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "prBodyNotes": [
        "⚠️ **PostgreSQL major update**: bumping the image is not enough. Also bump the database volume to the new major: `poweruptime-db-data-<major>` in `infrastructure/_base.yml` and `db-<major>` in `compose-dev.yml`, and update the volume table in `infrastructure/README.md#upgrading-postgresql`. Existing instances must follow that upgrade guide (`./pu update` aborts on a major version change)."
      ]
    }
  ],
  "schedule": ["* * 1,15 * *"],
  "semanticCommitScope": "",
  "semanticCommitType": "build",
  "semanticCommits": "enabled",
  "timezone": "Europe/Vienna"
}
