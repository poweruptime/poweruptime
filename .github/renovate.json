{
  "baseBranches": ["main"],
  "semanticCommits": "enabled",
  "semanticCommitScope": "",
  "semanticCommitType": "build",
  "commitBody": "See associated pull request for more information.",
  "schedule": [
    "after 11:00pm on the 1 day of the month",
    "before 4am on the 2 day of the month",
    "after 11:00pm on the 15 day of the month",
    "before 4am on the 16 day of the month"
  ],
  "timezone": "Europe/Vienna",
  "labels": ["dependencies"],
  "assignees": ["Dafnik"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "commitMessageAction": "lock file maintenance",
    "semanticCommitType": "build"
  },
  "packageRules": [
    {
      "matchPackagePatterns": ["^com\\.fasterxml\\.jackson"],
      "groupName": "Jackson dependencies"
    },
    {
      "matchPackagePatterns": ["^org\\.springframework\\.boot"],
      "groupName": "Spring Boot dependencies"
    },
    {
      "matchPackagePatterns": ["^org\\.jetbrains\\.kotlin"],
      "groupName": "Kotlin dependencies"
    },
    {
      "matchPackagePatterns": ["^io\\.jsonwebtoken"],
      "groupName": "JWT dependencies"
    },
    {
      "matchPackagePatterns": ["^org\\.apache\\."],
      "groupName": "Apache dependencies"
    },
    {
      "matchPackagePatterns": ["^org\\.liquibase"],
      "groupName": "Liquibase dependencies"
    },
    {
      "matchPackagePatterns": ["^org\\.springdoc"],
      "groupName": "Springdoc dependencies"
    },
    {
      "matchPackagePatterns": ["^com\\.bucket4j"],
      "groupName": "Bucket4j dependencies"
    },
    {
      "matchPackagePatterns": ["^org\\.testcontainers"],
      "groupName": "Testcontainers"
    },
    {
      "matchPackagePatterns": ["@react-email/components", "react-email", "react", "@types/react", "@types/react-dom", "prettier"],
      "groupName": "React Email"
    },
    {
      "matchPackageNames": ["typescript", "tslib"],
      "groupName": "typescript dependencies"
    },
    {
      "matchPackageNames": ["@schematics/angular"],
      "matchPackagePrefixes": ["@angular/", "@angular-devkit"],
      "groupName": "angular monorepo",
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    },
    {
      "matchPackagePatterns": ["*"],
      "excludePackageNames": ["typescript", "tslib", "@schematics/angular"],
      "excludePackagePatterns": ["@angular/", "@angular-devkit"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "minor-updates"
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": "major-update"
    }
  ],
  "extends": [
    "config:base",
    ":pinVersions",
    ":unpublishSafe",
    ":prNotPending",
    ":preserveSemverRanges",
    ":rebaseStalePrs"
  ]
}
