{
  "name": "poweruptime",
  "version": "0.0.1",
  "scripts": {
    "web:build": "pnpm -C web build",
    "web:build:docker": "pnpm -C web build:docker",
    "web:api": "pnpm -C web api",
    "web:lint": "pnpm -C web lint",
    "web:e2e": "pnpm -C web e2e",
    "web:e2e:docker": "pnpm -C web e2e:docker",
    "emails:start": "pnpm -C emails start",
    "emails:export": "pnpm -C emails export",
    "format:check": "prettier --check .",
    "detekt": "chmod +x ./detekt.sh && ./detekt.sh"
  },
  "packageManager": "pnpm@10.18.3",
  "private": true,
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "git-cliff": "2.10.1",
    "prettier": "3.6.2",
    "prettier-plugin-organize-attributes": "1.0.0",
    "prettier-plugin-sort-json": "4.1.1",
    "prettier-plugin-tailwindcss": "0.6.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "nx"
    ],
    "ignoredBuiltDependencies": [
      "sharp"
    ]
  }
}
