# top-most EditorConfig file
root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space

[*.{kt,kts}]
indent_size = 4
ij_continuation_indent_size = 4

[*.{ts,json,js}]
indent_size = 2
quote_type = single
ij_typescript_use_double_quotes = false

[*.md]
max_line_length = off
trim_trailing_whitespace = false
