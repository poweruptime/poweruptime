{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "poweruptime-web": {
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "configurations": {
            "development": {
              "extractLicenses": false,
              "optimization": false,
              "sourceMap": true
            },
            "docker": {
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.docker.ts"
                }
              ],
              "namedChunks": false,
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false
            }
          },
          "defaultConfiguration": "docker",
          "options": {
            "allowedCommonJsDependencies": ["rfdc"],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              },
              {
                "glob": "*",
                "input": "node_modules/bootstrap-icons/icons",
                "output": "/assets/icons"
              },
              {
                "glob": "**/*",
                "input": "node_modules/tinymce",
                "output": "/tinymce/"
              }
            ],
            "browser": "src/main.ts",
            "index": "src/index.html",
            "outputMode": "server",
            "outputPath": "dist/poweruptime-web",
            "scripts": ["node_modules/emoji-toolkit/lib/js/joypixels.min.js"],
            "server": "src/main.server.ts",
            "ssr": {
              "entry": "src/server.ts"
            },
            "styles": ["src/styles/material.scss", "src/styles.css"],
            "tsConfig": "tsconfig.app.json"
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "poweruptime-web:build:development"
            },
            "docker": {
              "buildTarget": "poweruptime-web:build:docker"
            }
          },
          "defaultConfiguration": "development"
        }
      },
      "prefix": "app",
      "projectType": "application",
      "root": "",
      "sourceRoot": "src"
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "changeDetection": "OnPush",
      "flat": true,
      "inlineStyle": true,
      "inlineTemplate": true,
      "prefix": "pu",
      "skipTests": true,
      "type": ""
    },
    "@schematics/angular:directive": {
      "flat": true,
      "skipTests": true
    },
    "@schematics/angular:guard": {
      "flat": true,
      "skipTests": true
    },
    "@schematics/angular:interceptor": {
      "flat": true,
      "skipTests": true
    },
    "@schematics/angular:pipe": {
      "flat": true,
      "skipTests": true
    },
    "@schematics/angular:service": {
      "flat": true,
      "skipTests": true
    }
  },
  "version": 1
}
