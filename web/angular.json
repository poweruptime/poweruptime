{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "newProjectRoot": "projects",
  "projects": {
    "poweruptime-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/poweruptime-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              },
              {
                "glob": "*",
                "input": "node_modules/dfx-bootstrap-icons/icons",
                "output": "/assets/icons"
              }
            ],
            "styles": ["src/styles.scss"],
            "scripts": [],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            },
            "allowedCommonJsDependencies": ["rfdc"]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "poweruptime-web:build:production"
            },
            "development": {
              "buildTarget": "poweruptime-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        }
      },
      "schematics": {
        "@schematics/angular:component": {
          "prefix": "pu",
          "inlineStyle": true,
          "inlineTemplate": true,
          "skipTests": true,
          "flat": true,
          "changeDetection": "OnPush",
          "type": ""
        },
        "@schematics/angular:directive": {
          "skipTests": true,
          "flat": true
        },
        "@schematics/angular:guard": {
          "skipTests": true,
          "flat": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true,
          "flat": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true,
          "flat": true
        },
        "@schematics/angular:service": {
          "skipTests": true,
          "flat": true
        }
      }
    }
  },
  "version": 1
}
