{
  "name": "poweruptime-web",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --no-hmr",
    "start:ssr": "node dist/poweruptime-web/server/server.mjs",
    "build": "ng build --configuration development --verbose",
    "build:docker": "ng build --configuration docker --verbose && pnpm i18n:optimize",
    "build:stats": "ng build --configuration docker --verbose --stats-json",
    "analyze": "esbuild-visualizer --metadata ./dist/poweruptime-web/stats.json",
    "test": "ng test",
    "lint": "ng lint",
    "api": "openapi-typescript http://localhost:8080/api/swagger/docs-json -o src/app/api/api-types.ts && prettier --write src/app/api/api-types.ts",
    "i18n:optimize": "transloco-optimize dist/poweruptime-web/browser/assets/i18n",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.0.3",
    "@angular/cdk": "20.0.3",
    "@angular/common": "20.0.3",
    "@angular/compiler": "20.0.3",
    "@angular/core": "20.0.3",
    "@angular/forms": "20.0.3",
    "@angular/material": "20.0.3",
    "@angular/material-date-fns-adapter": "20.0.3",
    "@angular/platform-browser": "20.0.3",
    "@angular/platform-browser-dynamic": "20.0.3",
    "@angular/platform-server": "20.0.3",
    "@angular/router": "20.0.3",
    "@angular/ssr": "20.0.2",
    "@davidlj95/ngx-meta": "20.0.0",
    "@fastify/http-proxy": "11.2.0",
    "@fastify/static": "8.2.0",
    "@jsverse/transloco": "7.6.1",
    "@jsverse/transloco-persist-lang": "7.0.2",
    "@ng-matero/extensions": "20.0.2",
    "@ngrx/operators": "19.2.1",
    "@ngrx/signals": "19.2.1",
    "@ngx-dropzone/cdk": "19.2.1",
    "@ngx-dropzone/material": "19.2.1",
    "@ngxpert/input-otp": "1.0.3",
    "@std/fmt": "npm:@jsr/std__fmt@1.0.8",
    "@tailwindcss/postcss": "4.1.10",
    "@tinymce/tinymce-angular": "9.0.0",
    "bootstrap-icons": "1.13.1",
    "canvas-confetti": "1.9.3",
    "chart.js": "^4.4.9",
    "d3-shape": "3.2.0",
    "date-fns": "4.1.0",
    "dfts-helper": "2.0.0",
    "dfx-bootstrap-icons": "20.0.0",
    "dfx-helper": "20.0.0",
    "dfx-openapi": "20.0.0",
    "dfx-qrcode": "20.0.0",
    "emoji-toolkit": "9.0.1",
    "eventsource": "4.0.0",
    "fastify": "5.4.0",
    "nanoid": "5.1.5",
    "ngx-mat-select-search": "8.0.2",
    "ngx-sonner": "3.1.0",
    "ngx-transloco-markup": "6.0.2",
    "ngxtension": "5.0.0",
    "rxjs": "7.8.2",
    "tinymce": "7.9.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "20.0.2",
    "@angular/cli": "20.0.2",
    "@angular/compiler-cli": "20.0.3",
    "@jsverse/transloco-keys-manager": "6.1.0",
    "@jsverse/transloco-optimize": "7.0.1",
    "@jsverse/transloco-utils": "7.0.2",
    "@jsverse/transloco-validator": "7.0.1",
    "@tailwindcss/typography": "0.5.16",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3-shape": "3.1.7",
    "@types/node": "22.15.31",
    "angular-eslint": "19.8.0",
    "autoprefixer": "10.4.21",
    "esbuild-visualizer": "0.7.0",
    "eslint": "9.27.0",
    "openapi-typescript": "7.8.0",
    "postcss": "8.5.5",
    "tailwindcss": "4.1.10",
    "tailwindcss-motion": "1.1.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.0"
  },
  "imports": {
    "#styles.css": "./src/styles.css"
  }
}
