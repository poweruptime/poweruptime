{
  "name": "poweruptime-web",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --no-hmr",
    "start:ssr": "node dist/poweruptime-web/server/server.mjs",
    "build": "ng build --configuration development --verbose",
    "build:docker": "ng build --configuration docker --verbose && pnpm i18n:optimize",
    "build:stats": "ng build --configuration docker --verbose --stats-json",
    "analyze": "esbuild-visualizer --metadata ./dist/poweruptime-web/stats.json",
    "test": "ng test",
    "api": "openapi-typescript http://localhost:8080/api/swagger/docs-json -o src/app/api/api-types.ts && prettier --write src/app/api/api-types.ts",
    "i18n:optimize": "transloco-optimize dist/poweruptime-web/browser/assets/i18n",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.2.10",
    "@angular/cdk": "19.2.16",
    "@angular/common": "19.2.10",
    "@angular/compiler": "19.2.10",
    "@angular/core": "19.2.10",
    "@angular/forms": "19.2.10",
    "@angular/material": "19.2.16",
    "@angular/material-date-fns-adapter": "19.2.16",
    "@angular/platform-browser": "19.2.10",
    "@angular/platform-browser-dynamic": "19.2.10",
    "@angular/platform-server": "19.2.10",
    "@angular/router": "19.2.10",
    "@angular/ssr": "19.2.11",
    "@davidlj95/ngx-meta": "^19.0.0",
    "@jsverse/transloco": "7.6.1",
    "@jsverse/transloco-persist-lang": "7.0.2",
    "@ng-matero/extensions": "19.3.3",
    "@ngrx/operators": "19.2.0",
    "@ngrx/signals": "19.2.0",
    "@ngx-dropzone/cdk": "19.2.1",
    "@ngx-dropzone/material": "19.2.1",
    "@ngxpert/input-otp": "^1.0.3",
    "@std/fmt": "npm:@jsr/std__fmt@1.0.8",
    "@swimlane/ngx-charts": "22.0.0",
    "@tailwindcss/postcss": "^4.1.1",
    "@tinymce/tinymce-angular": "^8.0.1",
    "canvas-confetti": "^1.9.3",
    "d3-shape": "3.2.0",
    "date-fns": "^4.1.0",
    "dfts-helper": "1.2.0",
    "dfx-bootstrap-icons": "3.0.1",
    "dfx-helper": "9.0.1",
    "dfx-openapi": "0.1.2",
    "dfx-qrcode": "^4.0.0",
    "emoji-toolkit": "^9.0.0",
    "eventsource": "^4.0.0",
    "express": "4.21.2",
    "http-proxy-middleware": "^3.0.5",
    "marked": "15.0.11",
    "nanoid": "5.1.5",
    "ngx-markdown": "19.1.1",
    "ngx-mat-select-search": "^8.0.0",
    "ngx-sonner": "3.1.0",
    "ngx-transloco-markup": "^6.0.2",
    "ngxtension": "5.0.0",
    "rxjs": "7.8.2",
    "tinymce": "^7.8.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.11",
    "@angular/cli": "19.2.11",
    "@angular/compiler-cli": "19.2.10",
    "@jsverse/transloco-keys-manager": "6.1.0",
    "@jsverse/transloco-optimize": "7.0.1",
    "@jsverse/transloco-utils": "^7.0.2",
    "@jsverse/transloco-validator": "7.0.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-shape": "3.1.7",
    "@types/express": "5.0.1",
    "@types/node": "22.15.18",
    "autoprefixer": "10.4.21",
    "esbuild-visualizer": "^0.7.0",
    "openapi-typescript": "7.8.0",
    "postcss": "8.5.3",
    "tailwindcss": "4.1.6",
    "tailwindcss-motion": "^1.1.0",
    "typescript": "5.8.3"
  },
  "imports": {
    "#styles.css": "./src/styles.css"
  }
}
