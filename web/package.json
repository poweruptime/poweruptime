{
  "name": "poweruptime-web",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng-icons-manager --watch & ng serve --hmr false",
    "start:ssr": "node dist/poweruptime-web/server/server.mjs",
    "build": "ng-icons-manager && NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration development",
    "build:docker": "ng-icons-manager && NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration docker && pnpm i18n:optimize",
    "build:stats": "ng-icons-manager && NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration docker --verbose --stats-json",
    "analyze": "esbuild-visualizer --metadata ./dist/poweruptime-web/stats.json",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "pnpm exec playwright test",
    "ng:e2e": "ng e2e",
    "ng:e2e:docker": "ng e2e --configuration docker",
    "api": "openapi-typescript http://localhost:8080/api/swagger/docs-json -o src/app/api/api-types.ts && prettier --write src/app/api/api-types.ts",
    "i18n:optimize": "transloco-optimize dist/poweruptime-web/browser/assets/i18n",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/platform-browser-dynamic": "21.2.19",
    "@angular/platform-server": "21.2.19",
    "@angular/router": "21.2.19",
    "@angular/ssr": "21.2.20",
    "@davidlj95/ngx-meta": "21.0.1",
    "@jsverse/transloco": "8.4.0",
    "@jsverse/transloco-persist-lang": "8.4.0",
    "@ng-icons/bootstrap-icons": "33.4.0",
    "@ng-icons/core": "33.4.0",
    "@ng-icons/lucide": "33.4.0",
    "@ngrx/operators": "21.1.1",
    "@ngrx/signals": "21.1.1",
    "@spartan-ng/brain": "1.3.1",
    "@std/fmt": "npm:@jsr/std__fmt@1.0.10",
    "@tailwindcss/postcss": "4.3.3",
    "@tinymce/tinymce-angular": "9.1.1",
    "angular-chrts": "0.1.0-beta.7",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dfts-helper": "2.1.0",
    "dfx-helper": "21.0.0",
    "dfx-openapi": "21.0.0",
    "dfx-qrcode": "21.0.0",
    "dfx-theme": "21.0.0",
    "dfx-transloco-markup": "21.0.0",
    "eventsource": "4.1.1",
    "express": "5.2.1",
    "http-proxy-middleware": "4.2.0",
    "nanoid": "5.1.16",
    "ngx-sonner": "3.1.0",
    "ngxtension": "7.3.0",
    "rxjs": "7.8.2",
    "sanitize-html": "^2.17.4",
    "satori": "0.29.0",
    "satori-html": "0.3.2",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "tinymce": "8.8.2",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.20",
    "@angular/cli": "21.2.20",
    "@angular/compiler-cli": "21.2.19",
    "@eslint/js": "10.0.1",
    "@jsverse/transloco-keys-manager": "8.1.1",
    "@jsverse/transloco-optimize": "8.4.0",
    "@jsverse/transloco-utils": "8.4.0",
    "@jsverse/transloco-validator": "8.4.0",
    "@nx/workspace": "22.7.8",
    "@playwright/test": "1.62.1",
    "@spartan-ng/cli": "1.3.1",
    "@tailwindcss/typography": "0.5.20",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3-shape": "3.1.8",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/sanitize-html": "^2.16.1",
    "angular-eslint": "21.4.0",
    "autoprefixer": "10.5.4",
    "esbuild-visualizer": "0.7.0",
    "eslint": "10.8.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "ng-icons-manager": "2.0.2",
    "openapi-typescript": "7.13.0",
    "playwright-ng-schematics": "21.1.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  },
  "imports": {
    "#styles.css": "./src/styles.css"
  }
}
