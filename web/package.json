{
  "name": "poweruptime-web",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng-icons-manager --watch & ng serve --hmr false",
    "start:ssr": "node dist/poweruptime-web/server/server.mjs",
    "build": "ng-icons-manager && NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration development",
    "build:docker": "ng-icons-manager && NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration docker && pnpm i18n:optimize",
    "build:stats": "ng-icons-manager && NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration docker --verbose --stats-json",
    "analyze": "esbuild-visualizer --metadata ./dist/poweruptime-web/stats.json",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "pnpm exec playwright test",
    "ng:e2e": "ng e2e",
    "ng:e2e:docker": "ng e2e --configuration docker",
    "api": "openapi-typescript http://localhost:8080/api/swagger/docs-json -o src/app/api/api-types.ts && prettier --write src/app/api/api-types.ts",
    "i18n:optimize": "transloco-optimize dist/poweruptime-web/browser/assets/i18n",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/platform-browser-dynamic": "22.1.7",
    "@angular/platform-server": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/ssr": "22.1.8",
    "@davidlj95/ngx-meta": "21.0.1",
    "@jsverse/transloco": "8.4.0",
    "@jsverse/transloco-persist-lang": "8.4.0",
    "@ng-icons/bootstrap-icons": "36.0.0",
    "@ng-icons/core": "36.0.0",
    "@ng-icons/lucide": "36.0.0",
    "@ngrx/operators": "22.0.1",
    "@ngrx/signals": "22.0.1",
    "@spartan-ng/brain": "1.4.1",
    "@std/fmt": "npm:@jsr/std__fmt@1.0.10",
    "@tailwindcss/postcss": "4.3.3",
    "@tinymce/tinymce-angular": "9.1.1",
    "angular-chrts": "0.1.0-beta.7",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dfts-helper": "2.1.0",
    "dfx-helper": "22.0.0",
    "dfx-openapi": "22.1.0",
    "dfx-qrcode": "22.0.0",
    "dfx-theme": "22.0.2",
    "dfx-transloco-markup": "22.0.1",
    "eventsource": "5.1.1",
    "express": "5.2.1",
    "http-proxy-middleware": "4.2.0",
    "nanoid": "6.0.1",
    "ngxtension": "7.3.0",
    "rxjs": "7.8.2",
    "sanitize-html": "^2.17.4",
    "satori": "0.32.0",
    "satori-html": "0.3.2",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "tinymce": "8.9.1",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@eslint/js": "10.0.1",
    "@jsverse/transloco-keys-manager": "8.1.1",
    "@jsverse/transloco-optimize": "8.4.0",
    "@jsverse/transloco-utils": "8.4.0",
    "@jsverse/transloco-validator": "8.4.0",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "1.63.0",
    "@spartan-ng/cli": "1.4.1",
    "@tailwindcss/typography": "0.5.20",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3-shape": "3.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/sanitize-html": "^2.16.1",
    "angular-eslint": "22.5.0",
    "autoprefixer": "10.6.0",
    "esbuild-visualizer": "0.7.0",
    "eslint": "10.10.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "ng-icons-manager": "2.0.2",
    "openapi-typescript": "7.13.0",
    "playwright-ng-schematics": "22.1.2",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "imports": {
    "#styles.css": "./src/styles.css"
  }
}
