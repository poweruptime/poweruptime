{
  "name": "poweruptime-web",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng-icons-manager --watch & ng serve --no-hmr",
    "start:ssr": "node dist/poweruptime-web/server/server.mjs",
    "build": "ng-icons-manager --verbose && ng build --configuration development --verbose",
    "build:docker": "ng-icons-manager --verbose && ng build --configuration docker --verbose && pnpm i18n:optimize",
    "build:stats": "ng build --configuration docker --verbose --stats-json",
    "analyze": "esbuild-visualizer --metadata ./dist/poweruptime-web/stats.json",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e:docker": "ng e2e --configuration docker",
    "api": "openapi-typescript http://localhost:8080/api/swagger/docs-json -o src/app/api/api-types.ts && prettier --write src/app/api/api-types.ts",
    "i18n:optimize": "transloco-optimize dist/poweruptime-web/browser/assets/i18n",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.0.5",
    "@angular/common": "21.0.6",
    "@angular/compiler": "21.0.6",
    "@angular/core": "21.0.6",
    "@angular/forms": "21.0.6",
    "@angular/material": "21.0.5",
    "@angular/material-date-fns-adapter": "21.0.5",
    "@angular/platform-browser": "21.0.6",
    "@angular/platform-browser-dynamic": "21.0.6",
    "@angular/platform-server": "21.0.6",
    "@angular/router": "21.0.6",
    "@angular/ssr": "21.0.4",
    "@slateui/theme": "1.0.0",
    "@davidlj95/ngx-meta": "20.0.1",
    "@fastify/http-proxy": "11.4.1",
    "@fastify/static": "9.0.0",
    "@jsverse/transloco": "8.2.0",
    "@jsverse/transloco-persist-lang": "8.2.0",
    "@ng-icons/bootstrap-icons": "33.0.0",
    "@ng-icons/core": "33.0.0",
    "@ng-icons/lucide": "33.0.0",
    "@ng-icons/material-icons": "33.0.0",
    "@ng-matero/extensions": "21.0.0",
    "@ngrx/operators": "21.0.1",
    "@ngrx/signals": "21.0.1",
    "@ngx-dropzone/cdk": "21.0.0",
    "@ngx-dropzone/material": "21.0.0",
    "@ngxpert/input-otp": "1.0.3",
    "@std/fmt": "npm:@jsr/std__fmt@1.0.8",
    "@tailwindcss/postcss": "4.1.18",
    "@tinymce/tinymce-angular": "9.1.1",
    "canvas-confetti": "1.9.4",
    "chart.js": "4.5.1",
    "date-fns": "4.1.0",
    "dfts-helper": "2.1.0",
    "dfx-helper": "21.0.0",
    "dfx-openapi": "21.0.0",
    "dfx-qrcode": "21.0.0",
    "dfx-transloco-markup": "0.0.2",
    "eventsource": "4.1.0",
    "fastify": "5.6.2",
    "nanoid": "5.1.6",
    "ngx-mat-select-search": "8.0.4",
    "ngx-sonner": "3.1.0",
    "ngxtension": "7.0.2",
    "rxjs": "7.8.2",
    "tinymce": "8.3.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.0.4",
    "@angular/cli": "21.0.4",
    "@angular/compiler-cli": "21.0.6",
    "@jsverse/transloco-keys-manager": "7.1.0",
    "@jsverse/transloco-optimize": "8.2.0",
    "@jsverse/transloco-utils": "8.2.0",
    "@jsverse/transloco-validator": "8.2.0",
    "@playwright/test": "1.57.0",
    "@tailwindcss/typography": "0.5.19",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3-shape": "3.1.7",
    "@types/node": "24.10.4",
    "angular-eslint": "21.1.0",
    "autoprefixer": "10.4.23",
    "chokidar": "5.0.0",
    "esbuild-visualizer": "0.7.0",
    "eslint": "9.39.2",
    "glob": "13.0.0",
    "ng-icons-manager": "1.1.4",
    "openapi-typescript": "7.10.1",
    "playwright-ng-schematics": "21.0.3",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18",
    "tailwindcss-motion": "1.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1"
  },
  "imports": {
    "#styles.css": "./src/styles.css"
  }
}
