{
  "name": "poweruptime-web",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng-icons-manager --watch & ng serve --hmr false",
    "start:ssr": "node dist/poweruptime-web/server/server.mjs",
    "build": "ng-icons-manager && ng build --configuration development",
    "build:docker": "ng-icons-manager && ng build --configuration docker && pnpm i18n:optimize",
    "build:stats": "ng build --configuration docker --verbose --stats-json",
    "analyze": "esbuild-visualizer --metadata ./dist/poweruptime-web/stats.json",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "pnpm exec playwright test",
    "ng:e2e": "ng e2e",
    "ng:e2e:docker": "ng e2e --configuration docker",
    "api": "openapi-typescript http://localhost:8080/api/swagger/docs-json -o src/app/api/api-types.ts && prettier --write src/app/api/api-types.ts",
    "i18n:optimize": "transloco-optimize dist/poweruptime-web/browser/assets/i18n",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.1.4",
    "@angular/common": "21.1.2",
    "@angular/compiler": "21.1.2",
    "@angular/core": "21.1.2",
    "@angular/forms": "21.1.2",
    "@angular/platform-browser": "21.1.2",
    "@angular/platform-browser-dynamic": "21.1.2",
    "@angular/platform-server": "21.1.2",
    "@angular/router": "21.1.2",
    "@angular/ssr": "21.1.2",
    "@davidlj95/ngx-meta": "21.0.1",
    "@jsverse/transloco": "8.2.1",
    "@jsverse/transloco-persist-lang": "8.2.1",
    "@ng-icons/bootstrap-icons": "33.0.0",
    "@ng-icons/core": "33.1.0",
    "@ng-icons/lucide": "33.0.0",
    "@ngrx/operators": "21.0.1",
    "@ngrx/signals": "21.0.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@spartan-ng/brain": "0.0.1-alpha.612",
    "@std/fmt": "npm:@jsr/std__fmt@1.0.9",
    "@tailwindcss/postcss": "4.1.18",
    "@tinymce/tinymce-angular": "9.1.1",
    "canvas-confetti": "1.9.4",
    "chart.js": "4.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "dfts-helper": "2.1.0",
    "dfx-helper": "21.0.0",
    "dfx-openapi": "21.0.0",
    "dfx-qrcode": "21.0.0",
    "dfx-theme": "^0.0.1",
    "dfx-transloco-markup": "0.0.2",
    "eventsource": "4.1.0",
    "express": "5.2.1",
    "http-proxy-middleware": "3.0.5",
    "nanoid": "5.1.6",
    "ngx-sonner": "3.1.0",
    "ngxtension": "7.0.2",
    "rxjs": "7.8.2",
    "satori": "0.19.1",
    "satori-html": "0.3.2",
    "tailwind-merge": "3.4.0",
    "tinymce": "8.3.2",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@angular/build": "21.1.2",
    "@angular/cli": "21.1.2",
    "@angular/compiler-cli": "21.1.2",
    "@eslint/js": "9.39.2",
    "@jsverse/transloco-keys-manager": "8.1.0",
    "@jsverse/transloco-optimize": "8.2.1",
    "@jsverse/transloco-utils": "8.2.1",
    "@jsverse/transloco-validator": "8.2.1",
    "@playwright/test": "1.58.2",
    "@spartan-ng/cli": "0.0.1-alpha.612",
    "@tailwindcss/typography": "0.5.19",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3-shape": "3.1.8",
    "@types/express": "5.0.6",
    "@types/node": "24.10.13",
    "angular-eslint": "21.2.0",
    "autoprefixer": "10.4.24",
    "chokidar": "5.0.0",
    "esbuild-visualizer": "0.7.0",
    "eslint": "9.39.2",
    "eslint-plugin-unused-imports": "4.3.0",
    "glob": "13.0.3",
    "ng-icons-manager": "1.1.4",
    "openapi-typescript": "7.10.1",
    "playwright-ng-schematics": "21.0.3",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  },
  "imports": {
    "#styles.css": "./src/styles.css"
  }
}
