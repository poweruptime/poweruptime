{
  "name": "poweruptime-web",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng-icons-manager --watch & ng serve --no-hmr",
    "start:ssr": "node dist/poweruptime-web/server/server.mjs",
    "build": "ng-icons-manager --verbose && ng build --configuration development --verbose",
    "build:docker": "ng-icons-manager --verbose && ng build --configuration docker --verbose && pnpm i18n:optimize",
    "build:stats": "ng build --configuration docker --verbose --stats-json",
    "analyze": "esbuild-visualizer --metadata ./dist/poweruptime-web/stats.json",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e:docker": "ng e2e --configuration docker",
    "api": "openapi-typescript http://localhost:8080/api/swagger/docs-json -o src/app/api/api-types.ts && prettier --write src/app/api/api-types.ts",
    "i18n:optimize": "transloco-optimize dist/poweruptime-web/browser/assets/i18n",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.0.1",
    "@angular/common": "21.0.1",
    "@angular/compiler": "21.0.1",
    "@angular/core": "21.0.1",
    "@angular/forms": "21.0.1",
    "@angular/material": "21.0.1",
    "@angular/material-date-fns-adapter": "21.0.1",
    "@angular/platform-browser": "21.0.1",
    "@angular/platform-browser-dynamic": "21.0.1",
    "@angular/platform-server": "21.0.1",
    "@angular/router": "21.0.1",
    "@angular/ssr": "21.0.1",
    "@angularui/theme": "0.1.4",
    "@davidlj95/ngx-meta": "20.0.1",
    "@fastify/http-proxy": "11.3.0",
    "@fastify/static": "8.3.0",
    "@jsverse/transloco": "7.6.1",
    "@jsverse/transloco-persist-lang": "7.0.2",
    "@ng-icons/bootstrap-icons": "32.5.0",
    "@ng-icons/core": "32.5.0",
    "@ng-icons/lucide": "33.0.0",
    "@ng-icons/material-icons": "33.0.0",
    "@ng-matero/extensions": "20.3.1",
    "@ngrx/operators": "20.1.0",
    "@ngrx/signals": "20.1.0",
    "@ngx-dropzone/cdk": "21.0.0",
    "@ngx-dropzone/material": "21.0.0",
    "@ngxpert/input-otp": "1.0.3",
    "@std/fmt": "npm:@jsr/std__fmt@1.0.8",
    "@tailwindcss/postcss": "4.1.17",
    "@tinymce/tinymce-angular": "9.1.1",
    "canvas-confetti": "1.9.4",
    "chart.js": "4.5.1",
    "date-fns": "4.1.0",
    "dfts-helper": "2.0.0",
    "dfx-helper": "20.1.0",
    "dfx-openapi": "20.1.0",
    "dfx-qrcode": "20.0.0",
    "eventsource": "4.1.0",
    "fastify": "5.6.2",
    "nanoid": "5.1.6",
    "ngx-mat-select-search": "8.0.4",
    "ngx-sonner": "3.1.0",
    "ngx-transloco-markup": "6.0.2",
    "ngxtension": "7.0.2",
    "rxjs": "7.8.2",
    "tinymce": "8.2.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.1",
    "@angular/cli": "21.0.1",
    "@angular/compiler-cli": "21.0.1",
    "@jsverse/transloco-keys-manager": "7.0.2",
    "@jsverse/transloco-optimize": "7.0.1",
    "@jsverse/transloco-utils": "7.0.2",
    "@jsverse/transloco-validator": "7.0.1",
    "@playwright/test": "1.57.0",
    "@tailwindcss/typography": "0.5.19",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3-shape": "3.1.7",
    "@types/node": "24.10.1",
    "angular-eslint": "21.0.1",
    "autoprefixer": "10.4.22",
    "chokidar": "5.0.0",
    "esbuild-visualizer": "0.7.0",
    "eslint": "9.39.1",
    "glob": "13.0.0",
    "ng-icons-manager": "1.1.3",
    "openapi-typescript": "7.10.1",
    "playwright-ng-schematics": "21.0.1",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.17",
    "tailwindcss-motion": "1.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  },
  "imports": {
    "#styles.css": "./src/styles.css"
  }
}
