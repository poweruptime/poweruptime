{
  "name": "poweruptime-web",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --no-hmr",
    "start:ssr": "NG_APP_BACKEND_URL=http://localhost:8080/api node dist/poweruptime-web/server/server.mjs",
    "transloco:optimize": "transloco-optimize dist/poweruptime-web/browser/assets/i18n",
    "build": "ng build",
    "build:prod": "ng build --configuration production && pnpm transloco:optimize",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api": "openapi-typescript http://localhost:8080/api/swagger/docs-json -o src/app/api/api-types.ts && prettier --write src/app/api/api-types.ts",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.2.0",
    "@angular/cdk": "19.2.1",
    "@angular/common": "19.2.0",
    "@angular/compiler": "19.2.0",
    "@angular/core": "19.2.0",
    "@angular/forms": "19.2.0",
    "@angular/material": "19.2.1",
    "@angular/platform-browser": "19.2.0",
    "@angular/platform-browser-dynamic": "19.2.0",
    "@angular/platform-server": "19.2.0",
    "@angular/router": "19.2.0",
    "@angular/ssr": "19.2.0",
    "@jsverse/transloco": "7.5.1",
    "@ng-matero/extensions": "19.2.1",
    "@ngneat/overview": "6.1.1",
    "@ngneat/until-destroy": "10.0.0",
    "@ngrx/operators": "19.0.1",
    "@ngrx/signals": "19.0.1",
    "@ngx-dropzone/cdk": "19.1.0",
    "@ngx-dropzone/material": "19.1.0",
    "@ngxpert/cmdk": "^3.0.0",
    "@ngxpert/input-otp": "^1.0.3",
    "@std/fmt": "npm:@jsr/std__fmt@1.0.5",
    "@swimlane/ngx-charts": "21.1.3",
    "d3-shape": "3.2.0",
    "dfts-helper": "1.2.0",
    "dfx-bootstrap-icons": "3.0.1",
    "dfx-helper": "9.0.1",
    "dfx-openapi": "0.1.1",
    "dfx-qrcode": "^4.0.0",
    "eventsource": "^3.0.5",
    "express": "4.21.2",
    "nanoid": "^5.0.9",
    "ngx-editor": "^18.0.0",
    "ngx-mat-select-search": "^8.0.0",
    "ngx-sonner": "3.0.0",
    "ngxtension": "4.3.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.0",
    "@angular/cli": "19.2.0",
    "@angular/compiler-cli": "19.2.0",
    "@jsverse/transloco-keys-manager": "^6.1.0",
    "@jsverse/transloco-optimize": "^7.0.1",
    "@jsverse/transloco-validator": "^7.0.1",
    "@types/d3-shape": "3.1.7",
    "@types/express": "5.0.0",
    "@types/node": "22.13.10",
    "autoprefixer": "10.4.20",
    "ngx-build-plus": "^19.0.0",
    "openapi-typescript": "7.6.1",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
