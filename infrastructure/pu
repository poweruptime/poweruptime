#!/usr/bin/env bash
set -euo pipefail
source .env
trap 'echo "ERROR"' ERR

TARGET_VERSION=""
TARGET_BACKUP_FILE=""
CMD=""
LOCAL=false
DRY_RUN=false

usage() {
  cat <<EOF
Usage: $0 [--local] [--dryRun] <command> [version-for-update|db-backup-file-path]

Commands:
  up               Deploy the stack (including pull)
  down             Stop and remove the stack
  start            Alias for up
  stop             Alias for down
  restart          Restart the stack
  pull             Pull the latest images
  backup           Create database backup (to ./backup/poweruptime-db/)
  backup-prune     Prune all except the latest 5 backups
  backup-verify    Verifies encrypted database backup
  backup-extract   Extracts encrypted database backup
  backup-import    Imports encrypted database backup into database container. (DANGEROUS!!)
  update           Pull the specified version, create database backup and redeploy the stack
  config           Print the combined config
  version          Show the poweruptime version

Options:
  --local          Use local compose files (local environment)
  --dryRun         Print the docker commands without executing
  -h, --help       Show this help message
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local)
        LOCAL=true
        shift
        ;;
      --dryRun)
        DRY_RUN=true
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      up|down|start|stop|restart|pull|backup|backup-prune|config|version)
        CMD="$1"
        shift
        ;;
      update)
        CMD="update"
        if [[ $# -ge 2 && ! "$2" =~ ^- ]]; then
          TARGET_VERSION="$2"
          shift 2
        else
          shift
        fi
        ;;
      backup-verify|backup-extract|backup-import)
        CMD="$1"
        if [[ $# -ge 2 && ! "$2" =~ ^- ]]; then
          TARGET_BACKUP_FILE="$2"
          shift 2
        else
          shift
        fi
        ;;
      *)
        echo "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  if [[ -z "$CMD" ]]; then
    usage
    exit 1
  fi
}

setup_compose_args() {
  if [[ "$LOCAL" == true ]]; then
    COMPOSE_ARGS=(
      -f _base.yml -f local.yml
      --env-file versions.env
      --env-file .env
    )
  else
    COMPOSE_ARGS=(
      -f _base.yml -f prod.yml
      --env-file versions.env
      --env-file .env
    )
  fi
}

confirm() {
  local prompt="${1:-Are you sure?}"
  local ans

  while true; do
    # -r: raw input, -p: prompt
    read -r -p "$prompt [y/N] " ans

    case "$ans" in
      [Yy]|[Yy][Ee][Ss]) return 0 ;;
      [Nn]|[Nn][Oo]|"")  return 1 ;;
      *)
        echo "Please answer yes or no." ;;
    esac
  done
}

run_cmd() {
  if [[ "$DRY_RUN" == true ]]; then
    echo "+ $*"
  else
    "$@"
  fi
}

do_pull() {
  run_cmd docker login ghcr.io
  run_cmd docker compose "${COMPOSE_ARGS[@]}" pull
}

do_up() {
  run_cmd docker login ghcr.io
  run_cmd docker compose "${COMPOSE_ARGS[@]}" pull
  run_cmd docker compose "${COMPOSE_ARGS[@]}" up -d

  if [[ "$DRY_RUN" == false ]]; then
    if [[ "$LOCAL" == true ]]; then
      echo "Successfully started poweruptime locally."
      echo "  - Web interface: http://localhost/"
      echo "  - API: http://localhost/api"
      echo "  - Traefik dashboard: http://localhost/traefik/dashboard/"
      echo "  - RabbitMQ Management: http://localhost/rabbit/"
    else
      docker image prune -a -f
      echo "Successfully deployed the new version/config"
    fi
  fi
}

do_down() {
  run_cmd docker compose "${COMPOSE_ARGS[@]}" down
}

do_restart() {
  run_cmd docker compose "${COMPOSE_ARGS[@]}" restart
}

do_config() {
  run_cmd docker compose "${COMPOSE_ARGS[@]}" config
}

do_version() {
  if [[ ! -f versions.env ]]; then
    echo "Error: versions.env not found" >&2
    exit 1
  fi

  grep -E '^POWERUPTIME_VERSION=' versions.env \
    | cut -d= -f2- \
    | tr -d '"' \
    || {
      echo "Error: POWERUPTIME_VERSION not set in versions.env" >&2
      exit 1
    }
}

do_backup() {
  mkdir -p ./backup/poweruptime-db

  OUT="./backup/poweruptime-db/$(date +'%Y%m%d%H%M%S').sql.gpg"
  run_cmd bash -c "docker exec --env PGPASSWORD='${DATABASE_PASSWORD}' poweruptime-db pg_dump -U '${DATABASE_USER}' '${DATABASE_NAME}' | gpg -c --batch --passphrase '${DATABASE_PASSWORD}' > '${OUT}'"
}

do_backup_verify() {
  if [[ -z "$TARGET_BACKUP_FILE" ]]; then
    echo "Missing argument: TARGET_BACKUP_FILE"
    usage
    exit 1
  fi

  gpg --batch --passphrase "${DATABASE_PASSWORD}" --decrypt "${TARGET_BACKUP_FILE}" > /dev/null
  echo "Verification succeeded: ${TARGET_BACKUP_FILE}"
}

do_backup_extract() {
  if [[ -z "$TARGET_BACKUP_FILE" ]]; then
    echo "Missing argument: TARGET_BACKUP_FILE"
    usage
    exit 1
  fi

  local out=${2:-"${TARGET_BACKUP_FILE%.gpg}"}

  run_cmd bash -c "gpg --batch --passphrase '${DATABASE_PASSWORD}' --decrypt '$TARGET_BACKUP_FILE' > '$out'"
  echo "Extraction succeeded"
}

do_backup_import() {
  if [[ -z "$TARGET_BACKUP_FILE" ]]; then
    echo "Missing argument: TARGET_BACKUP_FILE"
    usage
    exit 1
  fi

  do_backup_verify

  if ! confirm "Restore '$TARGET_BACKUP_FILE' into '$DATABASE_NAME'?"; then
    echo "Import cancelled."
    exit 1
  fi

  echo "Restoring ${TARGET_BACKUP_FILE} into ${DATABASE_NAME}..."
  run_cmd bash -c "gpg --batch --passphrase '${DATABASE_PASSWORD}' --decrypt '${TARGET_BACKUP_FILE}' | docker exec -i --env PGPASSWORD='${DATABASE_PASSWORD}' poweruptime-db psql -U '${DATABASE_USER}' -d '${DATABASE_NAME}'"
}

do_backup_prune() {
  run_cmd bash -c "cd ./backup/poweruptime-db && ls -1t | tail -n +6 | xargs rm -f --"
}

do_update() {
  LOG=./backup/update.log

  if [[ -d ../web && -d ../backend ]]; then
    echo "$(date +'%Y%m%d%H%M%S'): Detected development parent folder with web/ and backend/ – skipping update" | tee -a "$LOG"
    exit 1
  fi

  ts()  { date +'%Y%m%d%H%M%S'; }
  log() { echo "$(ts): $*" | tee -a "$LOG"; }
  err() { echo "$(ts): ERROR: $*" | tee -a "$LOG" >&2; }

  [[ "$DRY_RUN" == true ]] && log "DRY_RUN!!!"
  log "Update started"

  # fail fast if no version was provided
  if [[ -z "$TARGET_VERSION" ]]; then
    err "no version provided"
    exit 1
  fi

  log "Checking out version $TARGET_VERSION"
  run_cmd git fetch --tags
  if ! run_cmd git checkout "$TARGET_VERSION"; then
    err "failed to checkout version $TARGET_VERSION"
    exit 1
  fi

  log "Creating db backup"
  do_backup

  log "Removing old backups"
  do_backup_prune

  log "Redeploy stack"
  do_up

  log "Update finished"
}

main() {
  parse_args "$@"
  setup_compose_args

  case "$CMD" in
    up|start)           do_up          ;;
    down|stop)          do_down        ;;
    pull)               do_pull        ;;
    restart)            do_restart     ;;
    backup)             do_backup     ;;
    backup-prune)       do_backup_prune;;
    backup-verify)      do_backup_verify;;
    backup-extract)     do_backup_extract;;
    backup-import)      do_backup_import;;
    update)             do_update      ;;
    config)             do_config      ;;
    version)            do_version     ;;
  esac
}

main "$@"
